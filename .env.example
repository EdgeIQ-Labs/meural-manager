# Meural Watchdog Configuration
# Copy to .env and fill in your values

# Required: IP address of your Meural frame
MEURAL_FRAME_IP=10.5.10.97

# Optional: Local server URL (if running meural-manager or similar)
# MEURAL_SERVER_URL=http://localhost:3333

# Optional: Gallery ID to cycle through via slideshow
# MEURAL_GALLERY_ID=603178

# Optional: Device ID for API calls
# MEURAL_DEVICE_ID=74409

# Optional: Cache directory for downloaded images
MEURAL_CACHE_DIR=/tmp/meural-watchdog/

# Optional: Log file path
MEURAL_LOG_FILE=/tmp/meural-watchdog/watchdog.log

# Optional: Health check interval in milliseconds (default: 60000 = 1 minute)
CHECK_INTERVAL=60000

# Optional: Seconds between slideshow images (default: 30)
POST_INTERVAL=30

# Optional: Stale threshold in milliseconds (default: 120000 = 2 minutes)
STALE_THRESHOLD=120000

# Optional: Enable debug logging
# DEBUG=true
